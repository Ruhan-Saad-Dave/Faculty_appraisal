# ==============================================================================
# FACULTY APPRAISAL SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the actual values.
# NEVER commit the actual '.env' file to source control.

# --- 1. Database Configuration ---
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL="postgresql+asyncpg://fac_user:password@localhost:5432/faculty_appraisal"

# --- 2. Security & Authentication ---
USE_LOCAL_AUTH="true"
JWT_SECRET_KEY="your-super-secret-random-string"
ALLOW_MOCK_USER="false"
ENVIRONMENT="testing"  # "production" or "testing" (in production, staff authenticates via SSO; in testing, local auth is enabled)

# Keycloak / DYPIU SSO (OIDC Bearer Token Verification)
KEYCLOAK_ISSUER_URL="https://auth.dypiu.ac.in/realms/dypiu"
KEYCLOAK_CLIENT_ID="faculty-appraisal-frontend"
KEYCLOAK_AUDIENCE="faculty-appraisal-api"
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
# Optional override for JWKS URI (defaults to {KEYCLOAK_ISSUER_URL}/protocol/openid-connect/certs):
# KEYCLOAK_JWKS_URI="https://auth.dypiu.ac.in/realms/dypiu/protocol/openid-connect/certs"

# Legacy / Testing Central JWT bridge (Fallback when Keycloak is not configured)
# CENTRAL_JWT_SECRET="optional-legacy-central-secret"
# CENTRAL_JWT_PUBLIC_KEY="optional-legacy-central-public-key"
# CENTRAL_ALGORITHM="HS256"

# --- 3. System URLs ---
APP_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"

# --- 4. Email (SMTP / HTTP) Configuration ---
# For Google Workspace institutional accounts (e.g. appraisal@dypiu.ac.in):
# 1. Server: smtp.gmail.com | Port: 587 | TLS: true
# 2. IMPORTANT: You MUST use a 16-character Google App Password.
#    Regular Google login passwords will be rejected by Google with a 535 error.
#    To generate: Log into appraisal@dypiu.ac.in -> Google Account -> Security -> 2-Step Verification -> App Passwords.
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT=587
MAIL_TLS="true"
MAIL_SSL="false"
MAIL_USERNAME="appraisal@dypiu.ac.in"
MAIL_PASSWORD="your-16-char-app-password"
MAIL_FROM="appraisal@dypiu.ac.in"

# Backwards compatibility synonyms:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="appraisal@dypiu.ac.in"
SMTP_PASSWORD="your-16-char-app-password"

# Optional: HTTPS API Relays (Use if VM firewall blocks outbound SMTP ports 25/587/465)
# RESEND_API_KEY="re_..."
# SENDGRID_API_KEY="SG...."
# MAIL_HTTP_RELAY_URL="https://your-http-relay.example.com/send"

# --- 5. File Storage Configuration ---
USE_LOCAL_STORAGE="true"
LOCAL_STORAGE_DIR="./uploads"
GCP_STORAGE_BUCKET="your-gcs-bucket-name"
GCP_PROJECT_ID="your-gcp-project-id"
